{
  "targetDir": ".github/workflows/",
  "workflows": [
    "Release.yml",
    "architecture-memory-sync.yml",
    "architecture-pipeline.yml"
  ],
  "healthStatus": "PRODUCTION_READY",
  "issues": [
    {
      "workflow": "architecture-memory-sync.yml",
